# =============================================================
# ContentOS — Environment Variables Template
# =============================================================
# HOW TO USE:
#   1. Copy this file:  cp .env.example .env
#   2. Fill in all values marked with <REPLACE_ME>
#   3. NEVER commit your .env file to git (it's in .gitignore)
#
# Each section explains what the variable is, where to get it,
# and how to test it.
# =============================================================

# -------------------------------------------------------------
# SPRING BOOT APPLICATION (backend-core)
# These go in: backend-core/.env  OR  backend-core/src/main/resources/application-local.yml
# -------------------------------------------------------------

# Application server port
SERVER_PORT=8080

# Database connection
# For local Docker Compose: use these values as-is
DB_HOST=localhost
DB_PORT=5432
DB_NAME=contentos_db
DB_USERNAME=contentos_user
DB_PASSWORD=contentos_pass

# Redis connection
# For local Docker Compose: use these values as-is
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=contentos_redis_pass

# JWT Secret Key
# SECURITY: Must be at least 64 characters long in production.
# Generate one with:  openssl rand -hex 64
# Then paste the entire hex string below.
JWT_SECRET=<REPLACE_ME_use_openssl_rand_hex_64>

# JWT expiration in milliseconds
# 86400000 = 24 hours
# 604800000 = 7 days
JWT_EXPIRATION_MS=604800000

# Object Storage (MinIO locally, AWS S3 / Cloudflare R2 in production)
# For local Docker Compose MinIO: use these values as-is
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=contentos-media
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
# Important: Set to "true" for local MinIO, "false" for AWS S3
S3_PATH_STYLE_ACCESS=true

# Internal URL used by the backend to call the AI Engine
# If running both via docker-compose, use the service name
AI_ENGINE_URL=http://localhost:8000

# Internal webhook secret — the AI engine uses this to authenticate
# its status-update callbacks to the Spring Boot backend.
# Generate with:  openssl rand -hex 32
INTERNAL_WEBHOOK_SECRET=<REPLACE_ME_use_openssl_rand_hex_32>

# CORS — origins allowed to call the API
# For local development the React dev server runs on 5173
CORS_ALLOWED_ORIGINS=http://localhost:5173

# -------------------------------------------------------------
# AI ENGINE (ai-engine)
# These go in: ai-engine/.env
# -------------------------------------------------------------

# FastAPI server port
AI_ENGINE_PORT=8000

# ==== OPENAI ====
# Get your key at: https://platform.openai.com/api-keys
# Test it with:   curl https://api.openai.com/v1/models -H "Authorization: Bearer $OPENAI_API_KEY"
OPENAI_API_KEY=<REPLACE_ME>

# Which text model to use by default
# Options: gpt-4o, gpt-4o-mini, gpt-4-turbo
OPENAI_DEFAULT_LLM_MODEL=gpt-4o-mini

# Which image model to use
# Options: dall-e-3, dall-e-2
OPENAI_IMAGE_MODEL=dall-e-3

# ==== ANTHROPIC (Optional - Alternative LLM) ====
# Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=<REPLACE_ME_optional>

# ==== REPLICATE (Optional - Alternative image/video provider) ====
# Get your key at: https://replicate.com/account/api-tokens
# TODO: VERIFY CURRENT PROVIDER API before enabling
REPLICATE_API_KEY=<REPLACE_ME_optional>

# ==== ELEVENLABS (Text-to-Speech for Reel voiceovers) ====
# Get your key at: https://elevenlabs.io/
# TODO: VERIFY CURRENT PROVIDER API before enabling
ELEVENLABS_API_KEY=<REPLACE_ME_optional>

# Object storage for AI engine (same bucket as backend)
AI_S3_ENDPOINT=http://localhost:9000
AI_S3_REGION=us-east-1
AI_S3_BUCKET=contentos-media
AI_S3_ACCESS_KEY=minioadmin
AI_S3_SECRET_KEY=minioadmin
AI_S3_PATH_STYLE=true

# Redis (same instance as backend, used for job queue)
AI_REDIS_HOST=localhost
AI_REDIS_PORT=6379
AI_REDIS_PASSWORD=contentos_redis_pass

# URL of the Spring Boot backend (for webhook callbacks)
BACKEND_URL=http://localhost:8080
INTERNAL_WEBHOOK_SECRET=<REPLACE_ME_same_as_backend_value>

# -------------------------------------------------------------
# FRONTEND (frontend)
# These go in: frontend/.env.local
# All must start with VITE_ to be accessible in browser code.
# NEVER put secret keys here — this code runs in the browser.
# -------------------------------------------------------------

# The URL of your Spring Boot backend API
VITE_API_BASE_URL=http://localhost:8080

# Application name shown in the UI
VITE_APP_NAME=ContentOS
