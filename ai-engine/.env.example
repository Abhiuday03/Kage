# ============================================
# AI ENGINE ENVIRONMENT VARIABLES
# ============================================
# Copy this file to .env and fill in your values

# Internal API Security
# This secret must match the value in backend-core's application.yml
INTERNAL_API_SECRET=change_me_in_production

# OpenAI Configuration
OPENAI_API_KEY=sk-proj-...

# Backend Core Webhook URL
# This is where we send generated ideas back to Spring Boot
BACKEND_CORE_URL=http://localhost:8080

# Server Configuration
HOST=0.0.0.0
PORT=8000
